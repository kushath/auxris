{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auxris.org/schemas/auxris/dataset/v1/deletion-job.schema.json",
  "title": "Auxris Dataset Deletion Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deletion_id", "target_type", "target_id", "target_sha256", "state",
    "disposition", "last_error", "created_at", "started_at", "completed_at"
  ],
  "properties": {
    "deletion_id": { "type": "string", "format": "uuid" },
    "target_type": { "enum": ["scan", "catalog_asset"] },
    "target_id": { "type": ["string", "null"], "maxLength": 500 },
    "target_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": { "enum": ["queued", "running", "completed", "failed"] },
    "disposition": { "enum": ["logical_delete", "already_absent", null] },
    "last_error": { "type": ["string", "null"], "maxLength": 4096 },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
